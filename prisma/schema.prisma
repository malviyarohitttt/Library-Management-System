datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  Librarian @map("librarian")
}

enum MembershipStatus {
  Active  @map("active")
  Blocked @map("blocked")

  @@map("membership_status")
}

enum RentalStatus {
  Issued   @map("issued")
  Returned @map("returned")
  Overdue  @map("overdue")

  @@map("rental_status")
}

enum LibrarianStatus {
  Active    @map("active")
  Suspended @map("suspended")

  @@map("librarian_status")
}

model Librarian {
  id     Int             @id @default(autoincrement())
  name   String
  email  String          @unique
  status LibrarianStatus @default(Active)
  role   Role            @default(Librarian)

  rentals Rental[] @relation("IssuedBy")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  librarianMeta LibrarianMeta?

  @@map("librarian")
}

model LibrarianMeta {
  passwordSalt String? @map("password_salt")
  passwordHash String? @map("password_hash")

  librarian   Librarian @relation(fields: [librarianId], references: [id])
  librarianId Int       @unique @map("librarian_id")

  @@map("librarian_meta")
}

model Member {
  id               Int              @id @default(autoincrement())
  membershipId     String           @unique
  name             String
  email            String?          @unique
  phone            String           @unique
  address          String?
  joiningDate      DateTime         @default(now())
  membershipStatus MembershipStatus @default(Active)
  rentals          Rental[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("members")
}

model Book {
  id              Int     @id @default(autoincrement())
  title           String
  author          String
  isbn            String  @unique
  genre           String?
  description     String?
  publishedYear   Int?
  totalCopies     Int     @default(1)
  availableCopies Int     @default(1)

  rentals Rental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("books")
}

model Rental {
  id         Int          @id @default(autoincrement())
  issueDate  DateTime     @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     RentalStatus @default(Issued)

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  bookId Int
  book   Book @relation(fields: [bookId], references: [id])

  issuedById Int
  issuedBy   Librarian @relation("IssuedBy", fields: [issuedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rentals")
}

enum OtpTransport {
  Email  @map("email")
  Mobile @map("mobile")

  @@map("otp_transport")
}

model Otp {
  code String

  attempt    Int      @default(1) @db.SmallInt
  lastSentAt DateTime @default(now()) @map("last_sent_at")
  retries    Int      @default(0) @db.SmallInt

  transport OtpTransport
  target    String

  lastCodeVerified Boolean @default(false) @map("last_code_verified")
  blocked          Boolean @default(false)

  @@unique([transport, target])
  @@map("otp")
}
